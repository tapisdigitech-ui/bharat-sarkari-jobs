# Template only — copy to .env.local (development) or set in the hosting dashboard (staging/production).
# Every .env* file except this one is git-ignored. Never put a real value in this file.
# A production server REFUSES TO START on the errors listed in src/lib/env-rules.ts (validateEnv).

# ───────── Site ─────────
# Canonical base URL (https in production). Used for canonical links, sitemap, Open Graph and the crawler User-Agent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Search engines are blocked unless this is exactly "true". It is IGNORED (indexing stays off) for demo data and for
# Vercel preview deployments. Turn on only for the real production site after docs/PRODUCTION_READINESS.md §3.
ALLOW_INDEXING=false
NEXT_PUBLIC_ADS_ENABLED=false

# ───────── Data source ─────────
# "demo"     — built-in synthetic records, labelled "(Demo)", never indexed. Development default.
# "supabase" — the real database through Supabase (PostgREST + Row Level Security). Default for any built app.
DATA_SOURCE=demo
# A built app (next build / next start / Vercel) refuses DATA_SOURCE=demo unless this is "true".
# Allowed only for a clearly-labelled demo deployment; it is an ERROR on the live production site (VERCEL_ENV=production).
ALLOW_DEMO_IN_PRODUCTION=false

# ───────── Supabase (Project Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key. Safe in the browser: Row Level Security limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE-ROLE / secret key. SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit, never use in a
# client component. Read only by src/lib/supabase/admin.ts (server-only) for: cron routes, admin:create, lgd:import.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Scheduled jobs ─────────
# 16+ random chars (e.g. `openssl rand -hex 32`). Cron callers send "Authorization: Bearer <CRON_SECRET>". Required in production.
CRON_SECRET=
# Optional tuning (defaults shown). Schedules themselves live in vercel.json — see docs/DEPLOYMENT.md.
# SOURCE_CHECKS_PER_RUN=3
# LINK_CHECKS_PER_RUN=40

# ───────── Draft preview ─────────
# 16+ random chars. Signs the short-lived (30 min) staff preview links. Required in production.
PREVIEW_SECRET=

# ───────── TEST-ONLY switches (never set on staging/production) ─────────
# ALLOW_PRIVATE_SOURCE_HOSTS=1   lets the source checker read 127.0.0.1 (synthetic source in tests). Ignored on VERCEL_ENV=production.
# SOURCE_MIN_DELAY_MS=100        shortens the per-host politeness delay in tests.
