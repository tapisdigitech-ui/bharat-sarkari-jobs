{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/expire",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/sources",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/cron/links",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "40 21 * * *"
    }
  ]
}
